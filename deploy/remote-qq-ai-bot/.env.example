# QQ AI Bot
HOST=127.0.0.1
PORT=8765
BOT_INTERNAL_SECRET=change-me
LIBRARY_MODE=true
ALLOW_GROUPS=
ALLOW_USERS=

# NapCat OneBot HTTP（文件收发接口层依赖；需在 onebot11 配置中启用 httpServers）
NAPCAT_HTTP_URL=http://127.0.0.1:3001
NAPCAT_HTTP_TOKEN=

# 文件路径：宿主机 staging <-> NapCat 容器路径
NAPCAT_FILE_STAGING_DIR=/home/ubuntu/napcat/config/outbound
NAPCAT_CONTAINER_FILE_PREFIX=/app/napcat/config/outbound
QQ_FILE_DOWNLOAD_DIR=/home/ubuntu/qq-ai-bot/downloads
QQ_FILE_BASE64_MAX_BYTES=4194304

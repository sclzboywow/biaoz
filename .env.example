POSTGRES_DB=biaoz
POSTGRES_USER=biaoz
POSTGRES_PASSWORD=biaoz
DATABASE_URL=postgresql+psycopg://biaoz:biaoz@postgres:5432/biaoz
STORAGE_ROOT=/data/standard-docs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_API_TIMEOUT_MS=60000
COLLECTION_TASK_INLINE_WORKER=false

N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string

# AI 元数据提取后续接入时使用，MVP 可留空。

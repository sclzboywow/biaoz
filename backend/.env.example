APP_NAME=标准规范与项目依据动态管理系统
API_PREFIX=/api/v1
# 唯一业务库：本地开发用 localhost；Docker Compose 内默认 host.docker.internal，指向同一 PostgreSQL 实例。
DATABASE_URL=postgresql+psycopg://biaoz:biaoz@localhost:5432/biaoz
# 可选：独立测试库（需数据库 CREATEDB 权限，见 scripts/ensure_test_database.py）
# TEST_DATABASE_URL=postgresql+psycopg://biaoz:biaoz@localhost:5432/biaoz_test
STORAGE_ROOT=./data/standard-docs
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
URL_CHECK_INTERVAL_SECONDS=3600
URL_CHECK_ON_STARTUP=false
COLLECTION_TASK_INLINE_WORKER=true
